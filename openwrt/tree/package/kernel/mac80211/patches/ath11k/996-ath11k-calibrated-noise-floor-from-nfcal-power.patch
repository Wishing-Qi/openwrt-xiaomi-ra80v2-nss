From: ra80v2-nss project
Subject: [PATCH] wifi: ath11k: query calibrated noise floor via WMI_PDEV_GET_NFCAL_POWER

On QCN6122 (5 GHz) and IPQ5018, WMI_PDEV_BSS_CHAN_INFO_EVENTID reports an
uncalibrated raw noise floor (around -116 dBm on QCN6122) once the radio
enters AP mode. Query WMI_PDEV_GET_NFCAL_POWER_CMDID (0x401a, rate-limited
to once every 10 seconds during survey / fw_stats requests) and parse
WMI_PDEV_GET_NFCAL_POWER_EVENTID (0x400f) to populate survey->noise with the
firmware-calibrated noise floor for the matching channel frequency.

Signed-off-by: ra80v2-nss
---
--- a/drivers/net/wireless/ath/ath11k/core.h
+++ b/drivers/net/wireless/ath/ath11k/core.h
@@ -780,6 +780,10 @@ struct ath11k {
 	u32 chan_tx_pwr;
 	u32 num_stations;
 	struct survey_info survey[ATH11K_NUM_CHANS];
+	unsigned long nfcal_last_update;
+	u32 nfcal_freq[8];
+	s32 nfcal_power[8];
+	u8 nfcal_count;
 	struct completion bss_survey_done;
 
 	struct work_struct regd_update_work;
--- a/drivers/net/wireless/ath/ath11k/wmi.h
+++ b/drivers/net/wireless/ath/ath11k/wmi.h
@@ -234,6 +234,7 @@ enum wmi_tlv_cmd_id {
 	WMI_PDEV_SET_BASE_MACADDR_CMDID,
 	WMI_PDEV_SET_DSCP_TID_MAP_CMDID,
 	WMI_PDEV_BSS_CHAN_INFO_REQUEST_CMDID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x16,
+	WMI_PDEV_GET_NFCAL_POWER_CMDID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x1a,
 	WMI_PDEV_SEND_FD_CMDID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x20,
 	WMI_PDEV_SET_BIOS_SAR_TABLE_CMDID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x25,
 	WMI_PDEV_SET_BIOS_INTERFACE_CMDID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x26,
@@ -713,6 +714,7 @@ enum wmi_tlv_event_id {
 	WMI_PDEV_CTL_FAILSAFE_CHECK_EVENTID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x09,
 	WMI_PDEV_CSA_SWITCH_COUNT_STATUS_EVENTID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x0b,
 	WMI_PDEV_BSS_CHAN_INFO_EVENTID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x16,
+	WMI_PDEV_GET_NFCAL_POWER_EVENTID = WMI_TLV_CMD(WMI_GRP_PDEV) + 0x0f,
 	WMI_VDEV_START_RESP_EVENTID = WMI_TLV_CMD(WMI_GRP_VDEV),
 	WMI_VDEV_STOPPED_EVENTID,
 	WMI_VDEV_DELETE_RESP_EVENTID,
@@ -1910,6 +1912,24 @@ enum wmi_tlv_tag {
 	WMI_TAG_VDEV_SET_TPC_POWER_CMD = 0x3b8,
 };
 
+#define WMI_TAG_PDEV_GET_NFCAL_POWER_CMD	0x2d0
+#define WMI_TAG_PDEV_GET_NFCAL_POWER_EVENT	0x1db
+#define WMI_TAG_NFCAL_POWER_ITEM		0x1eb
+#define WMI_TAG_NFCAL_FREQ_ITEM			0x1ec
+#define WMI_TAG_NFCAL_VALID_ITEM		0x1ed
+
+struct wmi_pdev_get_nfcal_power_cmd {
+	u32 tlv_header;
+	u32 pdev_id;
+} __packed;
+
+struct wmi_pdev_nfcal_power_ev_fixed_param {
+	u32 pdev_id;
+	u32 num_chans;
+	u32 status;
+	u32 reserved;
+} __packed;
+
 enum wmi_bss_chan_info_req_type {
 	WMI_BSS_CHAN_INFO_READ_CLEAR = 1,
 	WMI_BSS_CHAN_INFO_READ = 2,
@@ -6370,6 +6390,7 @@ int ath11k_wmi_pdev_set_param(struct ath11k *ar, u32 param_id,
 			      u32 param_value, u8 pdev_id);
 int ath11k_wmi_pdev_bss_chan_info_request(struct ath11k *ar,
 					  enum wmi_bss_chan_info_req_type type);
+int ath11k_wmi_pdev_get_nfcal_power(struct ath11k *ar);
 int ath11k_wmi_send_set_ap_ps_param_cmd(struct ath11k *ar, u8 *peer_addr,
 					struct ath11k_wmi_ap_ps_arg *params);
 int ath11k_wmi_send_scan_start_cmd(struct ath11k *ar,
--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -2490,6 +2490,34 @@ int ath11k_wmi_pdev_bss_chan_info_request(struct ath11k *ar,
 	return ret;
 }
 
+int ath11k_wmi_pdev_get_nfcal_power(struct ath11k *ar)
+{
+	struct ath11k_pdev_wmi *wmi = ar->wmi;
+	struct wmi_pdev_get_nfcal_power_cmd *cmd;
+	struct sk_buff *skb;
+	int ret;
+
+	skb = ath11k_wmi_alloc_skb(wmi->wmi_ab, sizeof(*cmd));
+	if (!skb)
+		return -ENOMEM;
+
+	cmd = (struct wmi_pdev_get_nfcal_power_cmd *)skb->data;
+	cmd->tlv_header = FIELD_PREP(WMI_TLV_TAG,
+				     WMI_TAG_PDEV_GET_NFCAL_POWER_CMD) |
+			  FIELD_PREP(WMI_TLV_LEN, sizeof(*cmd) - TLV_HDR_SIZE);
+	cmd->pdev_id = ar->pdev->pdev_id;
+
+	ret = ath11k_wmi_cmd_send(wmi, skb, WMI_PDEV_GET_NFCAL_POWER_CMDID);
+	if (ret) {
+		ath11k_warn(ar->ab,
+			    "failed to send WMI_PDEV_GET_NFCAL_POWER cmd: %d\n",
+			    ret);
+		dev_kfree_skb(skb);
+	}
+
+	return ret;
+}
+
 int ath11k_wmi_send_set_ap_ps_param_cmd(struct ath11k *ar, u8 *peer_addr,
 					struct ath11k_wmi_ap_ps_arg *params)
 {
@@ -7800,6 +7828,114 @@ static void ath11k_wmi_pdev_bss_chan_info_event(struct ath11k_base *ab,
 	complete(&ar->bss_survey_done);
 }
 
+#define ATH11K_NFCAL_MAX_ENTRIES 96
+
+struct wmi_nfcal_power_parse {
+	const struct wmi_pdev_nfcal_power_ev_fixed_param *fixed_param;
+	u32 nf_cal_power[ATH11K_NFCAL_MAX_ENTRIES];
+	u32 nf_cal_freq[ATH11K_NFCAL_MAX_ENTRIES];
+	u32 nf_cal_valid[ATH11K_NFCAL_MAX_ENTRIES];
+	u16 num_power;
+	u16 num_freq;
+	u16 num_valid;
+};
+
+static int ath11k_wmi_pdev_nfcal_power_parser(struct ath11k_base *ab,
+					      u16 tag, u16 len,
+					      const void *ptr, void *data)
+{
+	struct wmi_nfcal_power_parse *tb = data;
+	const u8 *p = ptr;
+	const u8 *end;
+
+	switch (tag) {
+	case WMI_TAG_PDEV_GET_NFCAL_POWER_EVENT:
+		if (len < sizeof(*tb->fixed_param))
+			return -EPROTO;
+		tb->fixed_param = ptr;
+		break;
+	case WMI_TAG_ARRAY_UINT32:
+		if (len < 8)
+			return -EPROTO;
+		end = p + 8 + ((len - 8) & ~7U);
+		for (; p < end; p += 8) {
+			u16 item_tag = le16_to_cpup((const __le16 *)(p + 2));
+			u32 val = le32_to_cpup((const __le32 *)(p + 4));
+
+			switch (item_tag) {
+			case WMI_TAG_NFCAL_POWER_ITEM:
+				if (tb->num_power < ATH11K_NFCAL_MAX_ENTRIES)
+					tb->nf_cal_power[tb->num_power++] = val;
+				break;
+			case WMI_TAG_NFCAL_FREQ_ITEM:
+				if (tb->num_freq < ATH11K_NFCAL_MAX_ENTRIES)
+					tb->nf_cal_freq[tb->num_freq++] = val;
+				break;
+			case WMI_TAG_NFCAL_VALID_ITEM:
+				if (tb->num_valid < ATH11K_NFCAL_MAX_ENTRIES)
+					tb->nf_cal_valid[tb->num_valid++] = val;
+				break;
+			}
+		}
+		break;
+	}
+
+	return 0;
+}
+
+static void ath11k_wmi_pdev_nfcal_power_event(struct ath11k_base *ab,
+					      struct sk_buff *skb)
+{
+	struct wmi_nfcal_power_parse *tb;
+	struct ath11k *ar;
+	u8 count = 0;
+	u16 i, n;
+	int ret;
+
+	tb = kzalloc(sizeof(*tb), GFP_ATOMIC);
+	if (!tb)
+		return;
+
+	ret = ath11k_wmi_tlv_iter(ab, skb->data, skb->len,
+				  ath11k_wmi_pdev_nfcal_power_parser, tb);
+	if (ret) {
+		ath11k_warn(ab, "failed to parse nfcal power event: %d\n", ret);
+		goto exit;
+	}
+
+	if (!tb->fixed_param) {
+		ath11k_warn(ab, "nfcal power event without fixed param\n");
+		goto exit;
+	}
+
+	ar = ath11k_mac_get_ar_by_pdev_id(ab, tb->fixed_param->pdev_id);
+	if (!ar)
+		goto exit;
+
+	n = min3(tb->num_power, tb->num_freq, tb->num_valid);
+	for (i = 0; i < n && count < ARRAY_SIZE(ar->nfcal_freq); i++) {
+		if (!tb->nf_cal_valid[i] || !tb->nf_cal_power[i])
+			continue;
+		ar->nfcal_freq[count] = tb->nf_cal_freq[i];
+		ar->nfcal_power[count] = (s32)tb->nf_cal_power[i];
+		count++;
+	}
+
+	if (count) {
+		if (!ar->nfcal_count)
+			ath11k_info(ab,
+				    "calibrated noise floor %d dBm @ %u MHz (%u freqs)\n",
+				    ar->nfcal_power[0], ar->nfcal_freq[0],
+				    count);
+		ar->nfcal_count = count;
+	} else {
+		ar->nfcal_count = 0;
+	}
+
+exit:
+	kfree(tb);
+}
+
 static void ath11k_wmi_vdev_install_key_compl_event(struct ath11k_base *ab,
 						    struct sk_buff *skb)
 {
@@ -8380,6 +8518,9 @@ static void ath11k_wmi_tlv_op_rx(struct ath11k_base *ab, struct sk_buff *skb)
 	case WMI_PDEV_BSS_CHAN_INFO_EVENTID:
 		ath11k_wmi_pdev_bss_chan_info_event(ab, skb);
 		break;
+	case WMI_PDEV_GET_NFCAL_POWER_EVENTID:
+		ath11k_wmi_pdev_nfcal_power_event(ab, skb);
+		break;
 	case WMI_VDEV_START_RESP_EVENTID:
 		ath11k_wmi_vdev_start_resp_event(ab, skb);
 		break;
--- a/drivers/net/wireless/ath/ath11k/mac.c
+++ b/drivers/net/wireless/ath/ath11k/mac.c
@@ -8230,6 +8230,11 @@ static int ath11k_mac_op_get_survey(struct ieee80211_hw *hw, int idx,
 	if (idx == 0) {
 		reinit_completion(&ar->bss_survey_done);
 
+		if (time_after(jiffies, ar->nfcal_last_update + 10 * HZ)) {
+			ar->nfcal_last_update = jiffies;
+			ath11k_wmi_pdev_get_nfcal_power(ar);
+		}
+
 		ret = ath11k_wmi_pdev_bss_chan_info_request(ar,
 							    WMI_BSS_CHAN_INFO_READ);
 		if (ret) {
@@ -8253,6 +8258,22 @@ static int ath11k_mac_op_get_survey(struct ieee80211_hw *hw, int idx,
 	spin_lock_bh(&ar->data_lock);
 	memcpy(survey, &ar->survey[idx], sizeof(*survey));
 	spin_unlock_bh(&ar->data_lock);
+	if (ar->nfcal_count && survey->channel) {
+		u32 freq = survey->channel->center_freq;
+		u32 best_diff = U32_MAX;
+		u8 best = 0;
+		u8 i;
+
+		for (i = 0; i < ar->nfcal_count; i++) {
+			u32 diff = abs((s32)ar->nfcal_freq[i] - (s32)freq);
+			if (diff < best_diff) {
+				best_diff = diff;
+				best = i;
+			}
+		}
+		survey->filled |= SURVEY_INFO_NOISE_DBM;
+		survey->noise = ar->nfcal_power[best];
+	}
 	ret = 0;
 
 	if (!survey->filled)
@@ -9180,6 +9199,11 @@ int ath11k_mac_fw_stats_request(struct ath11k *ar,
 	unsigned long timeout, time_left;
 	int ret;
 
+	if (time_after(jiffies, ar->nfcal_last_update + 10 * HZ)) {
+		ar->nfcal_last_update = jiffies;
+		ath11k_wmi_pdev_get_nfcal_power(ar);
+	}
+
 	lockdep_assert_held(&ar->conf_mutex);
 
 	/* FW stats can only be collected for one vdev. Just fill the first
