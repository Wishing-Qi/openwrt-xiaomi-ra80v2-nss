# Shipped by this build for Xiaomi AX3000 v2 (RA80 v2).
#
# The SSIDs below gain the board's own MAC suffix on first boot, from
# /etc/uci-defaults/97-ra80v2-wifi-ssid.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '2g'
	option channel '1'
	option htmode 'HE40'
	option country 'CN'
	option txpower '24'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Xiaomi-AX3000-2.4G'
	option encryption 'none'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/b00a040.wifi'
	option band '5g'
	option channel '36'
	option htmode 'HE160'
	option country 'CN'
	option txpower '26'
	option cell_density '0'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option ssid 'Xiaomi-AX3000-5G'
	option encryption 'none'
